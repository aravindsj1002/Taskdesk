# Copy to .env and adjust.
DATABASE_URL=sqlite:///./taskdesk.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/taskdesk
LOG_LEVEL=INFO
LOG_JSON=false
# Free key from https://aistudio.google.com/apikey (leave empty to turn the AI feature off)
GEMINI_API_KEY=
# The Gemini model ID that works for you, e.g. a Flash-Lite model
AI_MODEL=